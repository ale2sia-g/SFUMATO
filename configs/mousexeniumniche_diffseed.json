{
  "run_name": "mousexeniumniche_diffseed",
  "input_csv": "xenium_mouse.csv",
  "columns": {
    "x": "x",
    "y": "y",
    "gene": "target_name",
    "num_id": "num_id"
  },
  "preprocess": {
    "k_list": [15, 20, 25, 30],
    "bgm_oversample": 1.5,
    "min_genes_per_bin": 120,
    "bin_width": 40,
    "factor": 8,
    "seed": 47,
    "use_svd": true,
    "comp": 10,
    "save_p2r": true,
    "alpha": 1.0,
    "rare_genes": null,
    "cache_dir": "preprocess_cache_mousexeniumniche_diffseed_svd"
  },
  "bgm": {
    "outroot": "results_mousexeniumniche_diffseed_svd",
    "save_transcript_proba": false,
    "beta_rare": 0.0,
    "merge_method": "complete",
    "merge_metric": "cosine",
    "bgm_weight_prior": 1,
    "use_hist_equalization": true
  },
  "umap": {
    "run": false,
    "max_points": 200000,
    "umap_components": 3,
    "n_neighbors": 30,
    "min_dist": 0.15,
    "point_size": 0.35
  }
}
